{
  "name": "create-stackpress-app",
  "version": "0.0.1",
  "author": "cdsiats",
  "type": "module",
  "description": "A project generator for stackpress applications.",
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc && npm run copy && npm run chmod-bin",
    "clean": "node src/scripts/clean-build.js",
    "copy": "node src/scripts/copy-assets.js",
    "chmod-bin": "node src/scripts/chmod-bin.js"
  },
  "keywords": [
    "stackpress",
    "scaffolding",
    "typescript",
    "node",
    "nodejs"
  ],
  "bin": {
    "create-stackpress-app": "dist/main.js"
  },
  "files": [ "dist" ],
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
